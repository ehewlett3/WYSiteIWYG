            "default": "#c8a158"
        },
        {
            "name": "crimson",
            "label": "Secondary accent",
            "type": "color",
            "default": "#1d6d59"
        },
        {
            "name": "bg",
            "label": "Page background",
            "type": "color",
            "default": "#081210"
