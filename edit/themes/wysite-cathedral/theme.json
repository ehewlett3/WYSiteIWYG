{
    "name": "WYSite Cathedral",
    "description": "A dramatic dark-and-gold showcase theme for WYSiteIWYG, with right-aligned branding, editorial side panels, and a strong product-site rhythm.",
    "inspiration": "Developed from the St John parish-inspired visual language, then reworked into a branded product and marketing theme for WYSiteIWYG itself.",
    "preview_blurb": "Dark parchment surfaces, gold highlights, a custom WYSite mark, and sidebars tuned for product benefits instead of parish logistics.",
    "dashboard": {
        "bg": "#f2ecda",
        "surface": "rgba(255, 251, 240, 0.96)",
        "ink": "#23332c",
        "muted": "#7d8f86",
        "line": "rgba(158, 36, 56, 0.16)",
        "accent": "#9e2438",
        "accent-2": "#c8a158",
        "shadow": "0 16px 44px rgba(35, 51, 44, 0.14)",
        "app-bg": "linear-gradient(180deg, #faf6e8, #f2ecda)",
        "font-sans": "\"Crimson Pro\", Georgia, serif",
        "font-serif": "\"Cinzel\", Georgia, serif"
    },
    "variables": [
        {
            "name": "gold",
            "label": "Gold accent",
