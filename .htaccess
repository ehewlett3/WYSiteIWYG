Options -Indexes
DirectoryIndex index.php index.html index.xml

<IfModule mod_rewrite.c>
RewriteEngine On

# A deployment may be a Git checkout. Never publish repository metadata, local
# assistant configuration, or internal continuity notes from the document root.
RewriteRule (^|/)\.(?:git|claude)(?:/|$) - [R=404,L,NC]
RewriteRule ^(?:HANDOFF(?:_[A-Z0-9_-]+)?\.md|OPUS_PROMPT\.md)$ - [R=404,L,NC]
RewriteRule ^doc(?:/|$) - [R=404,L,NC]

# Derive the URL path this site is deployed under (works at the domain root or
# in any subdirectory) and expose it as %{ENV:WYBASE}. Defaults to "/".
RewriteRule ^ - [E=WYBASE:/]
RewriteCond %{REQUEST_URI}::$1 ^(/.+/)(.+)::\2$
RewriteRule ^(.+)$ - [E=WYBASE:%1]

# Leave the editor application untouched.
RewriteRule ^edit(?:/|$) - [L]

# Canonicalize explicit index files.
RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]+/)?index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html$ %{ENV:WYBASE} [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s+/+(.+/)index\.html(?:[\s?]|$) [NC]
RewriteRule ^(.+/)index\.html$ %{ENV:WYBASE}$1 [R=301,L,NE]

# Canonicalize explicit browser-requested .html URLs to trailing-slash URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.html$ %{ENV:WYBASE}$1/ [R=301,L,NE]

# Map trailing-slash URLs back to matching .html files.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)/$ $1.html [L]
</IfModule>
