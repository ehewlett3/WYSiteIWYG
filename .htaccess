Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Leave the editor application untouched.
RewriteRule ^edit(?:/|$) - [L]

# Canonicalize explicit index files.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s+/+(.+/)index\.html(?:[\s?]|$) [NC]
RewriteRule ^(.+/)index\.html$ /$1 [R=301,L,NE]

# Canonicalize explicit browser-requested .html URLs to trailing-slash URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.html$ /$1/ [R=301,L,NE]

# Map trailing-slash URLs back to matching .html files.
RewriteCond %{REQUEST_URI} !^/edit(?:/|$) [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)/$ $1.html [L]
</IfModule>
